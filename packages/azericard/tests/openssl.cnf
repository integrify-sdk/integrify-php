#
# Yalnız testlər üçün minimal OpenSSL konfiqurasiyası.
#
# `openssl_pkey_new()` açar generasiya etmək üçün OpenSSL-in konfiqurasiya faylını
# oxumağa çalışır. Windows-da PHP `openssl.cnf` ilə gəlmir və `OPENSSL_CONF` təyin
# olunmayıbsa, funksiya heç bir izahat vermədən `false` qaytarır:
#
#     error:80000003:system library::No such process
#
# Bunun açarın özü ilə əlaqəsi yoxdur — açarın *oxunması* və onunla imzalanma
# (`openssl_pkey_get_private()`, `openssl_sign()`) konfiqurasiya tələb etmir, yalnız
# generasiya edir. Ona görə paket öz faylını gətirir və sistemdəki tapılmayanda
# `Factory::privateKey()` buna keçir.
#
# Fayl qəsdən minimaldır: OpenSSL-in yükləyə biləcəyi bir konfiqurasiya olması
# kifayətdir, burada heç bir dəyər RSA açarının generasiyasına təsir etmir.
#

[ req ]
distinguished_name = req_distinguished_name

[ req_distinguished_name ]
