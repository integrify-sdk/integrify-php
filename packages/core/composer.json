{
    "name": "integrify/core",
    "description": "Integrify API inteqrasiyalarını rahatlaşdıran bünövrə (core) kitabxanadır.",
    "type": "library",
    "keywords": ["integrify", "integrify-core", "api", "integration", "azerbaijan"],
    "homepage": "https://integrify.mmzeynalli.dev",
    "license": "MIT",
    "authors": [
        {
            "name": "mmzeynalli",
            "email": "miradil.zeynalli@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/Integrify-SDK/integrify-php/issues",
        "source": "https://github.com/Integrify-SDK/integrify-php/tree/main/packages/core",
        "docs": "https://integrify.mmzeynalli.dev"
    },
    "require": {
        "php": ">=8.2",
        "php-http/discovery": "^1.20",
        "psr/http-client": "^1.0",
        "psr/http-client-implementation": "^1.0",
        "psr/http-factory": "^1.1",
        "psr/http-factory-implementation": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/log": "^2.0 || ^3.0"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.9",
        "nyholm/psr7": "^1.8",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.4"
    },
    "autoload": {
        "psr-4": {
            "Integrify\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Integrify\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
