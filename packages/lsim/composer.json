{
    "name": "integrify/lsim",
    "description": "LSIM SMS inteqrasiyası — tək və toplu SMS göndərilməsi, hesabat və balans sorğuları.",
    "type": "library",
    "keywords": [
        "integrify",
        "lsim",
        "sms",
        "api",
        "integration",
        "azerbaijan"
    ],
    "homepage": "https://integrify.mmzeynalli.dev",
    "license": "MIT",
    "authors": [
        {
            "name": "mmzeynalli",
            "email": "miradil.zeynalli@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/integrify-sdk/integrify-php/issues",
        "source": "https://github.com/integrify-sdk/integrify-php/tree/main/packages/lsim",
        "docs": "https://integrify.mmzeynalli.dev/integrations/lsim"
    },
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "integrify/core": "^0.1"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.9",
        "nyholm/psr7": "^1.8",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.4"
    },
    "autoload": {
        "psr-4": {
            "Integrify\\Lsim\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Integrify\\Lsim\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
