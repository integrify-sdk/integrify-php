parameters:
    level: max
    # `packages` bütöv katalogdur, ona görə yeni paket avtomatik daxil olur.
    # (PHPStan `paths`-də `*` dəstəkləmir — yoxlanılıb.)
    paths:
        - packages
        - bin
    excludePaths:
        analyseAndScan:
            - packages/*/vendor
    treatPhpDocTypesAsCertain: false
