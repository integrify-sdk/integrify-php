<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnWarning="true"
         failOnRisky="true"
         beStrictAboutOutputDuringTests="true"
         cacheDirectory=".phpunit.cache">
    <!-- Bir testsuite, bütün paketlər: `directory` elementi `*` dəstəkləyir, ona
         görə yeni paket əlavə edəndə burada dəyişiklik lazım deyil.
         Tək paketi işlətmək üçün: `vendor/bin/phpunit packages/lsim/tests` -->
    <testsuites>
        <testsuite name="packages">
            <directory>packages/*/tests</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory>packages/*/src</directory>
        </include>
    </source>

    <!-- Burada `coverage` bloku QƏSDƏN yoxdur.

         `report` uşaq elementi olan `coverage` `hasCoverageReport()`-u hər çağırışda
         `true` edir, bu isə Xdebug və ya PCOV tələb edir. Driver yoxdursa PHPUnit
         runner xəbərdarlığı verir, `failOnPhpunitWarning` (default: true) səbəbindən
         isə `composer test` sıfırdan fərqli kodla bitir — bütün testlər keçsə belə.

         Coverage yalnız açıq şəkildə istənəndə hesablanır: `composer coverage`, və ya
         CI-da coverage bayraqları ilə. `source` bloku qalır; o, driver tələb etmir və
         coverage filtri kimi işləyir. -->
</phpunit>
